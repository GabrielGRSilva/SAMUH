# =============================================================================
# SAMUH .gitignore
# =============================================================================

# ---- Compiled binaries ----
samuh
samuh.exe
*.exe
*.dll
*.so
*.dylib
*.o
*.a

# ---- Test and coverage output ----
*.test
*.out
coverage.html
coverage.txt
*.prof
*.coverprofile

# ---- Generated scan reports ----
# Scan reports can contain details about vulnerabilities in YOUR code.
# Never commit them — they could expose your security weaknesses publicly.
*.sarif
report.*
!internal/reporter/**

# ---- OS-specific junk ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
ehthumbs.db

# ---- IDE and editor config ----
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.settings/
*.iml
*.code-workspace
.history/

# ---- Go workspace ----
vendor/

# ---- Environment, secrets, and credentials ----
# These files often contain API keys, passwords, or tokens.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
secrets.json
config.local.*
*.secret
*.keystore
*.jks

# ---- Debug artifacts ----
debug
__debug_bin*
*.log

# ---- Scratch / temp files ----
tmp/
temp/
scratch/
dist/
build/
